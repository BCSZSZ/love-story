{
  "name": "@tls/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/service.ts"
  },
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/lambda.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1141.0",
    "@aws-sdk/lib-dynamodb": "3.1141.0",
    "@aws-sdk/client-s3": "3.1141.0",
    "@tls/domain": "workspace:*",
    "@tls/engine": "workspace:*",
    "@tls/model-config": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "esbuild": "0.28.2"
  }
}
